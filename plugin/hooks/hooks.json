{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/ping.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/ping.py\"",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/collect.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/collect.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/flush.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/flush.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
