# Copy to .env and fill in. Real environment variables override this file.

# Leave empty to run the offline mock agent (great for UI work and demos without a key).
ANTHROPIC_API_KEY=
LEARNLOOP_MODEL=claude-haiku-4-5
# Set to 1 to force the mock agent even when a key is present.
LEARNLOOP_MOCK_AI=0

# Base URL used in card links printed in the terminal.
LEARNLOOP_PUBLIC_URL=http://127.0.0.1:8000
LEARNLOOP_RATE_LIMIT_PER_HOUR=30
LEARNLOOP_ANALYZE_BUDGET_SECONDS=12
LEARNLOOP_VERIFY_LINKS=1

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://learnloop.example.com when deployed behind HTTPS
DJANGO_CSRF_TRUSTED_ORIGINS=
